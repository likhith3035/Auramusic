<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <!-- Base full-bleed ambient background gradient -->
    <path android:pathData="M0,0h1024v1024h-1024z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="512"
                android:startY="0"
                android:endX="512"
                android:endY="1024"
                android:type="linear">
                <item android:color="#03254C" android:offset="0.0" />
                <item android:color="#081B33" android:offset="0.5" />
                <item android:color="#010914" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ambient radial glow center -->
    <path android:pathData="M 512,160 A 352,352 0 1 1 511.9,160 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="512"
                android:centerY="512"
                android:gradientRadius="352"
                android:type="radial">
                <item android:color="#2A00E5FF" android:offset="0.0" />
                <item android:color="#0000E5FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
