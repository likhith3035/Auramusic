<?xml version="1.0" encoding="utf-8"?>
<!--
  The pill widget's rounded-square cover placeholder when no artwork is present.
  Modern rounded square with cyan-neon accent stroke.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:angle="270"
        android:centerColor="#FF1B2130"
        android:centerY="0.45"
        android:endColor="#FF07090E"
        android:startColor="#FF2E3446"
        android:type="linear" />
    <stroke
        android:width="1.5dp"
        android:color="#4D38BDF8" />
</shape>
