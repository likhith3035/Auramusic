<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <group
        android:pivotX="512"
        android:pivotY="512"
        android:scaleX="0.72"
        android:scaleY="0.72">

        <!-- Outer harmonic wave (ambient) -->
        <path
            android:strokeWidth="14"
            android:strokeAlpha="0.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M 260,512 C 305,480 345,405 395,405 C 455,405 485,500 540,560 C 575,605 620,615 665,615 C 710,615 745,515 780,515 C 790,515 798,512 805,512">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="260"
                    android:startY="512"
                    android:endX="805"
                    android:endY="512"
                    android:type="linear">
                    <item android:color="#67E8F9" android:offset="0.0" />
                    <item android:color="#E879F9" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Secondary resonance wave -->
        <path
            android:strokeWidth="20"
            android:strokeAlpha="0.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M 220,512 C 285,490 330,360 395,360 C 465,360 495,490 545,580 C 580,645 630,660 675,660 C 720,660 755,490 795,490 C 810,490 820,505 828,512">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="220"
                    android:startY="512"
                    android:endX="828"
                    android:endY="512"
                    android:type="linear">
                    <item android:color="#38BDF8" android:offset="0.0" />
                    <item android:color="#A855F7" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Primary central soundwave -->
        <path
            android:strokeWidth="30"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M 180,512 C 260,500 320,310 395,310 C 475,310 500,480 550,600 C 590,695 640,715 680,715 C 730,715 765,460 805,460 C 825,460 838,495 848,512">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="180"
                    android:startY="512"
                    android:endX="848"
                    android:endY="512"
                    android:type="linear">
                    <item android:color="#00E5FF" android:offset="0.0" />
                    <item android:color="#38BDF8" android:offset="0.35" />
                    <item android:color="#818CF8" android:offset="0.65" />
                    <item android:color="#C084FC" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
