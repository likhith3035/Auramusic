        <!-- Primary central soundwave -->
        <path
            android:strokeWidth="38"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M 60,242 C 145,230 205,75 275,75 C 350,75 375,215 420,315 C 455,395 495,410 535,410 C 580,410 610,195 645,195 C 665,195 678,225 690,242" />
