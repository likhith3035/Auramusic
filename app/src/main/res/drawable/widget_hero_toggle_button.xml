<?xml version="1.0" encoding="utf-8"?>
<!--
  Hero Play/Pause circular gradient button with electric cyan-blue-purple neon
  glow and touch ripple feedback.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#50FFFFFF">
    <item>
        <layer-list>
            <!-- Subtle outer ambient glow border -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#3300E5FF" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#6600F5FF" />
                </shape>
            </item>
            <!-- Core radiant gradient button -->
            <item
                android:bottom="2.5dp"
                android:left="2.5dp"
                android:right="2.5dp"
                android:top="2.5dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="135"
                        android:centerColor="#2563EB"
                        android:endColor="#7C3AED"
                        android:startColor="#00F0FF"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
