<?xml version="1.0" encoding="utf-8"?>
<!--
  What the picker shows for the 2×2 widget on API 31+, where previewLayout is
  inflated live rather than an image being drawn.

  A copy of widget_media_compact with stand-in text.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_art">

    <!-- Top-Right AuraMusic Brand Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/widget_brand_badge_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="7dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_waveform" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:includeFontPadding="false"
            android:text="AuraMusic"
            android:textColor="#EEFFFFFF"
            android:textSize="10.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_band_compact"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal|bottom"
        android:orientation="vertical"
        android:paddingLeft="@dimen/widget_band_padding"
        android:paddingRight="@dimen/widget_band_padding"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/sf_pro_display_bold"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="@string/widget_preview_title"
            android:textColor="#FFFFFFFF"
            android:textSize="13.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/sf_pro_display_regular"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="Likhith • AuraMusic"
            android:textColor="#A0B4DE"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_button_compact"
                android:layout_weight="1"
                android:background="@drawable/widget_transport_button"
                android:contentDescription="@string/widget_previous"
                android:padding="9dp"
                android:src="@drawable/ic_widget_previous" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_button_compact"
                android:layout_weight="1"
                android:background="@drawable/widget_hero_toggle_button"
                android:contentDescription="@string/widget_play"
                android:padding="7dp"
                android:src="@drawable/ic_widget_play" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_button_compact"
                android:layout_weight="1"
                android:background="@drawable/widget_transport_button"
                android:contentDescription="@string/widget_next"
                android:padding="9dp"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
